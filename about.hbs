<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party notices (Rust)</title>
<style>body{font-family:system-ui,sans-serif;max-width:60rem;margin:2rem auto;padding:0 1rem}pre{white-space:pre-wrap;background:#f5f6f8;padding:1rem}</style>
</head>
<body>
<h1>Third-party notices (Rust components)</h1>
<p>This product includes the following open-source components.</p>
<h2>Licences used</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
