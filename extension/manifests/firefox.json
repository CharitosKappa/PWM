{
  "manifest_version": 3,
  "name": "PWM",
  "description": "Zero-knowledge password manager.",
  "version": "0.1.0",
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PWM"
  },
  "options_ui": {
    "page": "popup.html#settings",
    "open_in_tab": true
  },
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fill the login for this page"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["https://api.pwm.invalid/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pwm@pwm.invalid",
      "strict_min_version": "128.0"
    }
  }
}
