{
  "manifest_version": 3,
  "name": "PWM",
  "description": "Zero-knowledge password manager.",
  "version": "0.1.0",
  "minimum_chrome_version": "127",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PWM"
  },
  "options_ui": {
    "page": "popup.html#settings",
    "open_in_tab": true
  },
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fill the login for this page"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "offscreen",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["https://api.pwm.invalid/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["inline.html", "inline.js", "inline.css", "tokens.css"],
      "matches": ["https://*/*", "http://*/*"],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
