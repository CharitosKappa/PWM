{
  "manifest_version": 3,
  "name": "PWM",
  "description": "Zero-knowledge password manager.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "PWM" },
  "options_ui": { "page": "popup.html#settings", "open_in_tab": true },
  "permissions": ["storage", "alarms", "idle", "offscreen", "clipboardWrite"],
  "host_permissions": ["https://api.pwm.invalid/*"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
