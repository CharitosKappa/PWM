<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app (D52). Backups are off: the device's keys are bound to
     its Keystore and its cache can be synced again, so neither is copied. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning the Emergency Kit (D53 §3), asked only when the user taps Scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- The new-device notice (D60 §4), asked only from its switch in Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Autofill (D58 §4): reading the signing certificate of the app asking,
         among apps with a launcher icon, and of the listed browsers. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.android.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.brave.browser" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.duckduckgo.mobile.android" />
        <package android:name="com.vivaldi.browser" />
    </queries>

    <application
        android:name=".PwmApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PWM">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The fill screen an autofill entry opens (D58 §6). -->
        <activity
            android:name=".FillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />
        <!-- Push over FCM (D60): only the kind of push arrives here. -->
        <service
            android:name=".PwmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Firebase starts from code with the build's settings (D60 §1), never by itself. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <!-- No delivery data for BigQuery, and no Analytics. -->
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <!-- Autofill for apps and browsers (D58), turned on in the system's settings. -->
        <service
            android:name=".PwmAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
