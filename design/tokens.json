{
  "$description": "PWM shared design tokens (W3C Design Tokens format). Values follow the Calm direction picked for D1 on 2026-11-05 (the name is still open). Fonts: Manrope for text, Geist Mono for secrets (SIL OFL 1.1, D1), with system fonts as fallbacks. See design/README.md.",
  "version": { "$type": "number", "$value": 1 },
  "color": {
    "light": {
      "bg": { "$type": "color", "$value": "#FFFFFF", "$description": "App background" },
      "surface": { "$type": "color", "$value": "#F4F3FB", "$description": "Cards, sheets, list rows" },
      "surface-raised": { "$type": "color", "$value": "#FFFFFF", "$description": "Popovers, menus" },
      "border": { "$type": "color", "$value": "#E2E0F0" },
      "text": { "$type": "color", "$value": "#1E1B3A", "$description": "Primary text" },
      "text-muted": { "$type": "color", "$value": "#5D5A78", "$description": "Secondary text, captions" },
      "accent": { "$type": "color", "$value": "#4F3FD6", "$description": "Primary actions, links" },
      "accent-text": { "$type": "color", "$value": "#FFFFFF", "$description": "Text on accent" },
      "accent-soft": { "$type": "color", "$value": "#ECEAFD", "$description": "Secondary buttons, selected chips; text on it uses accent" },
      "focus": { "$type": "color", "$value": "#4F3FD6", "$description": "Keyboard focus ring" },
      "success": { "$type": "color", "$value": "#1C7C54" },
      "warning": { "$type": "color", "$value": "#8A5A00" },
      "danger": { "$type": "color", "$value": "#C0304A", "$description": "Destructive actions, breached/weak" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "#13121F" },
      "surface": { "$type": "color", "$value": "#1C1B2C" },
      "surface-raised": { "$type": "color", "$value": "#252438" },
      "border": { "$type": "color", "$value": "#34324A" },
      "text": { "$type": "color", "$value": "#EEEDF7" },
      "text-muted": { "$type": "color", "$value": "#A9A6C4" },
      "accent": { "$type": "color", "$value": "#A79BFF" },
      "accent-text": { "$type": "color", "$value": "#13121F" },
      "accent-soft": { "$type": "color", "$value": "#2A2650" },
      "focus": { "$type": "color", "$value": "#A79BFF" },
      "success": { "$type": "color", "$value": "#5FD39A" },
      "warning": { "$type": "color", "$value": "#F0B44C" },
      "danger": { "$type": "color", "$value": "#FF8095" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Manrope", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "All text", "$extensions": { "pwm.font": { "file": "Manrope.ttf", "weights": "200 800", "licence": "OFL-Manrope.txt" } } },
      "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "SF Mono", "Cascadia Mono", "Roboto Mono", "monospace"], "$description": "Passwords, Secret Key, TOTP codes", "$extensions": { "pwm.font": { "file": "GeistMono.ttf", "weights": "100 900", "licence": "OFL-GeistMono.txt" } } }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "type": {
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 12, "unit": "px" }, "fontWeight": "{font.weight.regular}", "lineHeight": 1.33 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 14, "unit": "px" }, "fontWeight": "{font.weight.regular}", "lineHeight": 1.43 } },
    "body-strong": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 14, "unit": "px" }, "fontWeight": "{font.weight.semibold}", "lineHeight": 1.43 } },
    "title": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 17, "unit": "px" }, "fontWeight": "{font.weight.semibold}", "lineHeight": 1.29 } },
    "headline": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 22, "unit": "px" }, "fontWeight": "{font.weight.semibold}", "lineHeight": 1.27 } },
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 28, "unit": "px" }, "fontWeight": "{font.weight.semibold}", "lineHeight": 1.21 } },
    "secret": { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": { "value": 15, "unit": "px" }, "fontWeight": "{font.weight.regular}", "lineHeight": 1.4 } }
  },
  "space": {
    "0": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "5": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "7": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "sm": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Inputs, chips" },
    "md": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "List rows, icon tiles; buttons are pills (full)" },
    "lg": { "$type": "dimension", "$value": { "value": 20, "unit": "px" }, "$description": "Cards, sheets" },
    "full": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" }, "$description": "Pills, avatars" }
  }
}
